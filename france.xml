---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>OX1Digital - France</title>
    <description>Updates and posts about life in France</description>
    <link>{{ site.url }}/france/</link>
    <atom:link href="{{ site.url }}/france.xml" rel="self" type="application/rss+xml"/>

    {% assign france_items = site.france | sort: 'date' | reverse %}
    {% for item in france_items limit:15 %}
      <item>
        <title>{{ item.title | xml_escape }}</title>
        <description>{{ item.excerpt | strip_html | xml_escape }}</description>
        <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
        <link>{{ site.url }}{{ item.url }}</link>
        <guid isPermaLink="true">{{ site.url }}{{ item.url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
